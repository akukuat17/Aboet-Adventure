# ── Database (wajib di production) ─────────────────────────────
# Postgres apa saja: Neon / Vercel Postgres / Supabase. Pakai connection string "pooled".
# Kosongkan saat development lokal → otomatis pakai database tertanam (PGlite, folder .data/)
DATABASE_URL=

# ── Auth admin (wajib di production) ───────────────────────────
# String acak panjang, contoh: openssl rand -base64 32
AUTH_SECRET=

# ── Seed akun admin pertama ────────────────────────────────────
ADMIN_NAMA="Admin Aboet"
ADMIN_EMAIL=admin@aboet.com
ADMIN_PASSWORD=ganti-password-ini

# ── Upload foto (Vercel Blob) ──────────────────────────────────
# Dibuat otomatis saat Blob store dihubungkan ke project di Vercel.
# Kosong di lokal → foto disimpan ke public/uploads
BLOB_READ_WRITE_TOKEN=

# ── Opsional ───────────────────────────────────────────────────
# Nomor WA cadangan bila pengaturan di admin belum diisi
WA_NUMBER=6285799001985
